# ============================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO
# ============================================

# Kaggle Configuration (Recomendado)
# Las credenciales se leen automáticamente de ~/.kaggle/kaggle.json
KAGGLE_DATASET=thedevastator/online-retail-sales-and-customer-data
KAGGLE_FILE=Online Retail.csv

# Fallback: URL del Dataset (si no se usa Kaggle)
DATASET_URL=https://archive.ics.uci.edu/ml/machine-learning-databases/00352/Online%20Retail.xlsx

# Configuración de DuckDB
DUCKDB_PATH=dwh/retail_analytics.duckdb

# Configuración de dbt
DBT_PROFILES_DIR=dwh
DBT_TARGET=dev

# Configuración de Logs
LOG_LEVEL=INFO
LOG_FILE=logs/ingestion.log
